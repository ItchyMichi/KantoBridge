{
	"schemaVersion": 1,
	"id": "kantobridge",
	"version": "${version}",
	"name": "Kanto Bridge",
	"description": "Minecraft half of Kanto Bridge: mirrors a hidden Gen1Recomp game in Minecraft, with Cobblemon owning all Pokémon. Based on the Pokemon Gen 1 Recompilation Project by BOIS CLUB GAMES, LLC (https://github.com/bryanthaboi/gen1recomp).",
	"authors": [
		"ItchyMichi"
	],
	"contributors": [
		"Claude (Anthropic), in Claude Code"
	],
	"contact": {
		"homepage": "https://github.com/ItchyMichi/KantoBridge",
		"sources": "https://github.com/ItchyMichi/KantoBridge",
		"issues": "https://github.com/ItchyMichi/KantoBridge/issues"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/kantobridge/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.kantobridge.KantoBridge"
		],
		"client": [
			"dev.kantobridge.client.KantoBridgeClient"
		]
	},
	"mixins": [
		"kantobridge.mixins.json",
		{
			"config": "kantobridge.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "kantobridge.dev.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"cobblemon": "~1.8.1"
	}
}
