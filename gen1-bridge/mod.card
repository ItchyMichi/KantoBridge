-- Sharing metadata for Gen1Recomp's mod manager and gallery tooling.
-- The loader never reads this file; manifest.json is what loads the mod.
return {
  summary = "Links this hidden Gen1Recomp game to Minecraft (Kanto Bridge) over a local TCP socket.",
  author = "Kanto Bridge contributors",
  tags = { "tool", "network", "bridge" },
  differences = {
    changed = {
      "display options are pinned to classic (no tilt, zoom, render pipelines, wide battles or dynamic UI) and text speed to FAST, in memory, while the mod is on",
      "while Minecraft is connected, the hidden party follows Cobblemon's (party.sync); a gift sent to a full party's box is taken out of the Gen 1 box, since Cobblemon's PC keeps it",
    },
    added = {
      "listens on 127.0.0.1 (port option, default 27151) for one Kanto Bridge client at a time",
      "sends the player's position and state each step, and a full story snapshot on connect",
      "mirrors the hidden game's text boxes, YES/NO, menus, lists, quantities and naming, and its NPCs, to Minecraft, and applies Minecraft's answers as button taps",
      "while Minecraft watches a graphical screen, captures the finished frame (read-only) and sends it as a 160x144 PNG",
      "while Minecraft is connected, the battles the story starts (scripted, rival, map trainers) wait for its Cobblemon battle, whose result is applied with the game's own effects",
      "gifts (the starter included) and heals are sent to Minecraft",
      "a status table in mod.exports (versions, counts, flags) for test drivers",
    },
    known = {
      "wild encounters, the bag, the Pokedex and the story's flags are not mirrored yet; they arrive in later milestones",
    },
  },
  credits = {
    { who = "Pokemon Gen 1 Recompilation Project", for_ = "the engine and its mod platform" },
  },
  compat = { engine = "0.0.0-dev || >=0.3.49 <0.4.0", modApi = 2 },
}
