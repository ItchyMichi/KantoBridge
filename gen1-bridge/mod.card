-- Sharing metadata for Gen1Recomp's mod manager and gallery tooling.
-- The loader never reads this file; manifest.json is what loads the mod.
return {
  summary = "Links this hidden Gen1Recomp game to Minecraft (Kanto Bridge) over a local TCP socket.",
  author = "Kanto Bridge contributors",
  tags = { "tool", "network", "bridge" },
  differences = {
    changed = {
      "display options are pinned to classic (no tilt, zoom, render pipelines, wide battles or dynamic UI) and text speed to FAST, in memory, while the mod is on",
    },
    added = {
      "listens on 127.0.0.1 (port option, default 27151) for one Kanto Bridge client at a time",
      "sends the player's position and state each step, and a full story snapshot on connect",
      "a status table in mod.exports (versions, counts, flags) for test drivers",
    },
    known = {
      "steps, dialogue, NPCs and the story are not mirrored yet; they arrive in later milestones",
    },
  },
  credits = {
    { who = "Pokemon Gen 1 Recompilation Project", for_ = "the engine and its mod platform" },
  },
  compat = { engine = "0.0.0-dev || >=0.3.49 <0.4.0", modApi = 2 },
}
