{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kantobridge.invalid/protocol/messages/hello.reject.schema.json",
  "title": "hello.reject",
  "description": "The handshake failed; gen1-bridge closes the connection after sending it.",
  "x-type": "hello.reject",
  "x-legs": ["g2m"],
  "x-re": "required",
  "type": "object",
  "required": ["reason", "protocol"],
  "additionalProperties": false,
  "properties": {
    "reason": {"enum": ["protocol", "role", "malformed", "busy"]},
    "protocol": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "description": "gen1-bridge's own protocol number."
    }
  }
}
