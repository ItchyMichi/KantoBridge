{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kantobridge.invalid/protocol/messages/story.state.schema.json",
  "title": "story.state",
  "description": "The player's blockade-relevant state: full on join, then deltas.",
  "x-type": "story.state",
  "x-legs": [
    "c2s"
  ],
  "x-re": "never",
  "type": "object",
  "required": [
    "full"
  ],
  "additionalProperties": false,
  "properties": {
    "full": {
      "type": "boolean"
    },
    "active": {
      "type": "array",
      "items": {
        "$ref": "../defs.schema.json#/$defs/cellKey"
      },
      "uniqueItems": true,
      "description": "full: every active story cell."
    },
    "add": {
      "type": "array",
      "items": {
        "$ref": "../defs.schema.json#/$defs/cellKey"
      },
      "uniqueItems": true
    },
    "remove": {
      "type": "array",
      "items": {
        "$ref": "../defs.schema.json#/$defs/cellKey"
      },
      "uniqueItems": true
    },
    "surf": {
      "type": "boolean"
    },
    "bike": {
      "type": "boolean"
    },
    "run": {
      "type": "boolean",
      "description": "FA8 item 7 (D4): the hidden player is running (player.state.run); the server gives it the running speed. Optional; absent in a full state: not running."
    },
    "lit": {
      "type": "array",
      "items": {
        "$ref": "../defs.schema.json#/$defs/mapId"
      },
      "uniqueItems": true
    },
    "region": {
      "$ref": "../defs.schema.json#/$defs/regionId",
      "description": "MG3 (several games): the region this message belongs to; absent = the legacy region. The client tags what it relays with its link's region; the server routes a tagged message to that region's link."
    }
  },
  "if": {
    "properties": {
      "full": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "active",
      "surf",
      "bike",
      "lit"
    ]
  }
}
