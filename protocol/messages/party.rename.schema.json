{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kantobridge.invalid/protocol/messages/party.rename.schema.json",
  "title": "party.rename",
  "description": "The Name Rater renamed a Pokémon. An empty nick clears it.",
  "x-type": "party.rename",
  "x-legs": ["g2m", "c2s"],
  "x-re": "never",
  "type": "object",
  "required": ["uid", "nick"],
  "additionalProperties": false,
  "properties": {
    "uid": {"$ref": "../defs.schema.json#/$defs/uid"},
    "nick": {"type": "string", "maxLength": 32, "x-rom-derived": true}
  }
}
