{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kantobridge.invalid/protocol/messages/bag.sync.schema.json",
  "title": "bag.sync",
  "description": "The battle-usable bag subset, mirrored into the Minecraft inventory.",
  "x-type": "bag.sync",
  "x-legs": ["g2m", "c2s"],
  "x-re": "never",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 9999},
      "properties": {},
      "propertyNames": {"$ref": "../defs.schema.json#/$defs/itemId"}
    }
  }
}
