  "additionalProperties": false,
  "properties": {
    "target": {
      "$ref": "../defs.schema.json#/$defs/npcId",
      "description": "\"player\" or an NPC id."
    },
    "bubble": {"enum": ["!", "?", "happy", null]},
    "frames": {"$ref": "../defs.schema.json#/$defs/frames"}
  }
}
