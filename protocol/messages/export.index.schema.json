{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kantobridge.invalid/protocol/messages/export.index.schema.json",
  "title": "export.index",
  "description": "Request (M->G, {}) or reply (G->M, re set): the exportable resources.",
  "x-type": "export.index",
  "x-legs": ["m2g", "g2m"],
  "x-re": "optional",
  "oneOf": [
    {"$ref": "../defs.schema.json#/$defs/empty"},
    {
      "type": "object",
      "required": ["game", "engine", "bridge", "resources"],
      "additionalProperties": false,
      "properties": {
        "game": {"$ref": "../defs.schema.json#/$defs/gameId"},
        "engine": {"type": "string", "pattern": "^[0-9A-Za-z.+_-]+$", "maxLength": 32},
        "bridge": {"type": "string", "pattern": "^[0-9A-Za-z.+_-]+$", "maxLength": 32},
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "id", "hash", "size"],
            "additionalProperties": false,
            "properties": {
              "kind": {"$ref": "../defs.schema.json#/$defs/exportKind"},
              "id": {"$ref": "../defs.schema.json#/$defs/id"},
              "hash": {"$ref": "../defs.schema.json#/$defs/hash"},
              "size": {"type": "integer", "minimum": 0, "maximum": 1048576}
            }
          },
          "maxItems": 4096
        }
      }
    }
  ]
}
