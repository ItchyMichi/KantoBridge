{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kantobridge.invalid/protocol/messages/snapshot.schema.json",
  "title": "snapshot",
  "description": "The full story view: sent after hello.ok and in answer to resync.",
  "x-type": "snapshot",
  "x-legs": [
    "g2m"
  ],
  "x-re": "optional",
  "type": "object",
  "required": [
    "ingame",
    "player",
    "state",
    "flags",
    "toggles",
    "blocks",
    "lit",
    "bag",
    "money",
    "coins",
    "badges",
    "party",
    "dex",
    "npcs"
  ],
  "additionalProperties": false,
  "properties": {
    "ingame": {
      "type": "boolean",
      "description": "True when the hidden game is in the overworld and player is live. False at the title screen and intro: player is then only the save's last position, and a client must not move the Minecraft player to it."
    },
    "player": {
      "$ref": "../defs.schema.json#/$defs/place"
    },
    "state": {
      "$ref": "../defs.schema.json#/$defs/playerState"
    },
    "flags": {
      "type": "array",
      "items": {
        "$ref": "../defs.schema.json#/$defs/flagId"
      },
      "uniqueItems": true,
      "description": "Every set flag."
    },
    "toggles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "boolean"
        },
        "properties": {}
      },
      "properties": {},
      "propertyNames": {
        "$ref": "../defs.schema.json#/$defs/mapId"
      },
      "description": "map -> object name -> visible: every object whose effective visibility (toggles, items taken, statics beaten) differs from its map record's hidden default."
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "map",
          "bx",
          "by",
          "block"
        ],
        "additionalProperties": false,
        "properties": {
          "map": {
            "$ref": "../defs.schema.json#/$defs/mapId"
          },
          "bx": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "by": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "block": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      },
      "description": "Live map blocks that differ from the map data.",
      "x-rom-derived": true
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "map",
          "x",
          "y",
          "metatile"
        ],
        "additionalProperties": false,
        "properties": {
          "map": {
            "$ref": "../defs.schema.json#/$defs/mapId"
          },
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1023
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1023
          },
          "metatile": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1023
          },
          "pass": {
            "enum": [
              "ground",
              "water",
              "solid"
            ],
            "description": "SE1: the live cell's collision class, from its collision byte (PROTOCOL.md \"Story rules\": ground walkable, water surfers only, solid nobody)."
          }
        }
      },
      "description": "MG7 (G3C): Gen 3 only, the current map's cells whose metatile or collision class differs from the map data (story.cells; SE1: with pass)",
      "x-rom-derived": true
    },
    "lit": {
      "type": "array",
      "items": {
        "$ref": "../defs.schema.json#/$defs/mapId"
      },
      "uniqueItems": true
    },
    "bag": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9999
      },
      "properties": {},
      "propertyNames": {
        "$ref": "../defs.schema.json#/$defs/itemId"
      }
    },
    "money": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999999
    },
    "coins": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "badges": {
      "type": "array",
      "items": {
        "$ref": "../defs.schema.json#/$defs/itemId"
      },
      "maxItems": 16,
      "uniqueItems": true
    },
    "party": {
      "type": "array",
      "items": {
        "$ref": "../defs.schema.json#/$defs/shadowMon"
      },
      "maxItems": 6,
      "description": "The shadow party."
    },
    "dex": {
      "type": "object",
      "required": [
        "seen",
        "owned"
      ],
      "additionalProperties": false,
      "properties": {
        "seen": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/nationalDex"
          },
          "uniqueItems": true
        },
        "owned": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/nationalDex"
          },
          "uniqueItems": true
        }
      }
    },
    "npcs": {
      "type": "object",
      "required": [
        "map",
        "list"
      ],
      "additionalProperties": false,
      "properties": {
        "map": {
          "$ref": "../defs.schema.json#/$defs/mapId"
        },
        "list": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/npc"
          },
          "maxItems": 64
        }
      }
    },
    "ui": {
      "type": "object",
      "properties": {},
      "description": "The open UI, as its ui.open data, if any.",
      "x-rom-derived": true
    },
    "routes": {
      "$ref": "../defs.schema.json#/$defs/routeProgress",
      "description": "Wild Routes (WR2): every zone's progress in the hidden save."
    },
    "away": {
      "type": "object",
      "required": [
        "map",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "map": {
          "$ref": "../defs.schema.json#/$defs/mapId"
        },
        "x": {
          "$ref": "../defs.schema.json#/$defs/coord"
        },
        "y": {
          "$ref": "../defs.schema.json#/$defs/coord"
        }
      },
      "description": "MG2: present while a region.park hold is up (or its marker is still in the save after a link drop): the cell the hidden player stood on when parked."
    }
  }
}
