{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kantobridge.invalid/protocol/messages/battle.start.schema.json",
  "title": "battle.start",
  "description": "The hidden game starts a battle that Cobblemon fights.",
  "x-type": "battle.start",
  "x-legs": [
    "g2m",
    "c2s"
  ],
  "x-re": "never",
  "type": "object",
  "required": [
    "battle",
    "kind",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "battle": {
      "$ref": "../defs.schema.json#/$defs/id"
    },
    "kind": {
      "enum": [
        "trainer",
        "rival",
        "scripted",
        "static",
        "surf",
        "fish"
      ]
    },
    "trainer": {
      "type": "object",
      "required": [
        "cls",
        "party"
      ],
      "additionalProperties": false,
      "properties": {
        "cls": {
          "$ref": "../defs.schema.json#/$defs/symbol",
          "description": "Trainer class symbol."
        },
        "party": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023,
          "description": "Party index within the class (Gen 1), or the trainer's id (Gen 3: Emerald's reach 854)."
        },
        "name": {
          "type": "string",
          "maxLength": 32,
          "x-rom-derived": true
        },
        "npc": {
          "$ref": "../defs.schema.json#/$defs/npcId"
        },
        "map": {
          "$ref": "../defs.schema.json#/$defs/mapId"
        },
        "x": {
          "$ref": "../defs.schema.json#/$defs/coord"
        },
        "y": {
          "$ref": "../defs.schema.json#/$defs/coord"
        }
      }
    },
    "team": {
      "type": "array",
      "items": {
        "$ref": "../defs.schema.json#/$defs/teamMon"
      },
      "maxItems": 6,
      "minItems": 1,
      "x-rom-derived": true
    },
    "wild": {
      "type": "object",
      "required": [
        "dex",
        "level"
      ],
      "additionalProperties": false,
      "properties": {
        "dex": {
          "$ref": "../defs.schema.json#/$defs/nationalDex"
        },
        "level": {
          "$ref": "../defs.schema.json#/$defs/level"
        },
        "x": {
          "$ref": "../defs.schema.json#/$defs/coord"
        },
        "y": {
          "$ref": "../defs.schema.json#/$defs/coord"
        },
        "dvs": {
          "$ref": "../defs.schema.json#/$defs/dvs",
          "description": "MG9 (G2F): the wild Pokémon's DVs (Gen 2), so Cobblemon's matches its stats, gender and shininess."
        },
        "item": {
          "$ref": "../defs.schema.json#/$defs/heldItem"
        },
        "shiny": {
          "type": "boolean"
        },
        "gender": {
          "$ref": "../defs.schema.json#/$defs/gender"
        },
        "form": {
          "$ref": "../defs.schema.json#/$defs/form"
        }
      },
      "x-rom-derived": true
    },
    "rules": {
      "type": "object",
      "required": [
        "catch",
        "flee"
      ],
      "additionalProperties": false,
      "properties": {
        "catch": {
          "type": "boolean"
        },
        "flee": {
          "type": "boolean"
        }
      }
    },
    "use": {
      "type": "array",
      "items": {
        "$ref": "../defs.schema.json#/$defs/uid"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 6,
      "description": "FOREIGN_POKEMON_PLAN §4.12: the player's Pokémon Cobblemon may use (Crystal's Bug-Catching Contest: the lead); absent: the whole party."
    },
    "format": {
      "enum": [
        "singles",
        "double",
        "multi"
      ],
      "description": "§4.12: the battle format; absent: singles. multi seats an ally beside the player (Steven at the Space Center)."
    },
    "ally": {
      "type": "object",
      "required": [
        "team"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 32,
          "x-rom-derived": true
        },
        "team": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/teamMon"
          },
          "minItems": 1,
          "maxItems": 6
        }
      },
      "x-rom-derived": true,
      "description": "§4.12, format multi: the partner who fights beside the player."
    },
    "region": {
      "$ref": "../defs.schema.json#/$defs/regionId",
      "description": "MG3 (several games): the region this message belongs to; absent = the legacy region. The client tags what it relays with its link's region; the server routes a tagged message to that region's link."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "trainer",
              "rival"
            ]
          }
        }
      },
      "then": {
        "required": [
          "trainer",
          "team"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "static",
              "surf",
              "fish"
            ]
          }
        }
      },
      "then": {
        "required": [
          "wild"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "scripted"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "team"
            ]
          },
          {
            "required": [
              "wild"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "ally"
        ]
      },
      "then": {
        "properties": {
          "format": {
            "const": "multi"
          }
        },
        "required": [
          "format"
        ]
      }
    }
  ]
}
