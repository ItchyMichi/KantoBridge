{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kantobridge.invalid/protocol/messages/player.blocked.schema.json",
  "title": "player.blocked",
  "description": "A requested step was refused; the client snaps back to the cell centre.",
  "x-type": "player.blocked",
  "x-legs": ["g2m"],
  "x-re": "never",
  "type": "object",
  "required": ["dir", "reason", "map", "x", "y"],
  "additionalProperties": false,
  "properties": {
    "dir": {"$ref": "../defs.schema.json#/$defs/dir"},
    "reason": {"enum": ["tile", "entity", "bounds", "script"]},
    "map": {"$ref": "../defs.schema.json#/$defs/mapId"},
    "x": {"$ref": "../defs.schema.json#/$defs/coord"},
    "y": {"$ref": "../defs.schema.json#/$defs/coord"},
    "n": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
  }
}
