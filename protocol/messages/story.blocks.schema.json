{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kantobridge.invalid/protocol/messages/story.blocks.schema.json",
  "title": "story.blocks",
  "description": "Live map block changes: Cut, doors, scripted swaps.",
  "x-type": "story.blocks",
  "x-legs": ["g2m"],
  "x-re": "never",
  "type": "object",
  "required": ["map", "changes"],
  "additionalProperties": false,
  "properties": {
    "map": {"$ref": "../defs.schema.json#/$defs/mapId"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bx", "by", "block"],
        "additionalProperties": false,
        "properties": {
          "bx": {"type": "integer", "minimum": 0, "maximum": 255},
          "by": {"type": "integer", "minimum": 0, "maximum": 255},
          "block": {"type": "integer", "minimum": 0, "maximum": 255}
        }
      },
      "x-rom-derived": true
    }
  }
}
