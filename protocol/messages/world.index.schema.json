{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kantobridge.invalid/protocol/messages/world.index.schema.json",
  "title": "world.index",
  "description": "The WorldIndex JSON, in parts on join.",
  "x-type": "world.index",
  "x-legs": [
    "s2c"
  ],
  "x-re": "never",
  "type": "object",
  "required": [
    "index",
    "count",
    "hash",
    "part"
  ],
  "additionalProperties": false,
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "hash": {
      "$ref": "../defs.schema.json#/$defs/hash",
      "description": "SHA-256 of the whole WorldIndex JSON."
    },
    "part": {
      "type": "string",
      "maxLength": 200000,
      "x-rom-derived": true
    },
    "region": {
      "$ref": "../defs.schema.json#/$defs/regionId",
      "description": "MG3 (several games): the region this message belongs to; absent = the legacy region. The client tags what it relays with its link's region; the server routes a tagged message to that region's link."
    }
  }
}
