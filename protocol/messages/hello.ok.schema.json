{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kantobridge.invalid/protocol/messages/hello.ok.schema.json",
  "title": "hello.ok",
  "description": "The handshake succeeded.",
  "x-type": "hello.ok",
  "x-legs": ["g2m"],
  "x-re": "required",
  "type": "object",
  "required": ["protocol", "bridge", "engine", "game", "session"],
  "additionalProperties": false,
  "properties": {
    "protocol": {"type": "integer", "minimum": 1, "maximum": 1000},
    "bridge": {"type": "string", "pattern": "^[0-9A-Za-z.+_-]+$", "maxLength": 32},
    "engine": {"type": "string", "pattern": "^[0-9A-Za-z.+_-]+$", "maxLength": 32},
    "game": {"enum": ["red", "blue"]},
    "session": {
      "$ref": "../defs.schema.json#/$defs/id",
      "description": "Random per gen1-bridge start, so a client can tell a restart from a reconnect."
    }
  }
}
