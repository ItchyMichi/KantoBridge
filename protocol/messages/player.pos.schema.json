{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kantobridge.invalid/protocol/messages/player.pos.schema.json",
  "title": "player.pos",
  "description": "The hidden player's cell. Sent at each step start (target cell) and on non-step changes.",
  "x-type": "player.pos",
  "x-legs": ["g2m"],
  "x-re": "never",
  "type": "object",
  "required": ["map", "x", "y", "facing", "kind", "frames"],
  "additionalProperties": false,
  "properties": {
    "map": {"$ref": "../defs.schema.json#/$defs/mapId"},
    "x": {"$ref": "../defs.schema.json#/$defs/coord"},
    "y": {"$ref": "../defs.schema.json#/$defs/coord"},
    "facing": {"$ref": "../defs.schema.json#/$defs/dir"},
    "kind": {
      "enum": [
        "walk",
        "bike",
        "surf",
        "ledge",
        "script",
        "spin",
        "current",
        "slope",
        "push",
        "sync"
      ]
    },
    "frames": {
      "$ref": "../defs.schema.json#/$defs/frames",
      "description": "How long the move takes; 0 for an instant change."
    },
    "n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "The move.step this answers, if any."
    }
  }
}
