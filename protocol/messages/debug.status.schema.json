{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kantobridge.invalid/protocol/messages/debug.status.schema.json",
  "title": "debug.status",
  "description": "Test role only. Request {} or reply with counts and states (never content).",
  "x-type": "debug.status",
  "x-legs": ["m2g", "g2m"],
  "x-re": "optional",
  "oneOf": [
    {"$ref": "../defs.schema.json#/$defs/empty"},
    {
      "type": "object",
      "required": ["npcs", "topState", "mode", "flags"],
      "additionalProperties": {"type": ["integer", "boolean"]},
      "properties": {
        "npcs": {"$ref": "../defs.schema.json#/$defs/count"},
        "topState": {"$ref": "../defs.schema.json#/$defs/symbol"},
        "mode": {"enum": ["idle", "screen", "forced", "cutscene", "busy"]},
        "flags": {"$ref": "../defs.schema.json#/$defs/count"},
        "engineMissing": {
          "type": "array",
          "maxItems": 256,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9_.]+$", "maxLength": 96},
          "description": "Engine modules and members gen1-bridge relies on that this engine lacks (module or module.member); empty on the tested engine."
        },
        "unionRoom": {
          "enum": ["on", "off"],
          "description": "Whether the engine's Union Room setting patched this boot's Pokemon Centers (must be off)."
        }
      }
    }
  ]
}
