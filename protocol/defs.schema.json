{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kantobridge.invalid/protocol/defs.schema.json",
  "title": "defs",
  "description": "Shared definitions for Kanto Bridge message schemas.",
  "$defs": {
    "gameId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,15}$",
      "maxLength": 16,
      "minLength": 1,
      "description": "A Gen1Recomp game id (protocol/games.json): red, blue, yellow, gold, ..., emerald."
    },
    "regionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,23}$",
      "maxLength": 24,
      "minLength": 1,
      "description": "A region of the one overworld built from one game's export, e.g. kanto, hoenn (MULTI_GAME_PLAN §4.1)."
    },
    "family": {
      "enum": ["gen1", "gen2", "gen3"],
      "description": "An engine family: gen1 (Red, Blue, Yellow), gen2 (Gold, Silver, Crystal), gen3 (FireRed, LeafGreen, Ruby, Sapphire, Emerald). One bridge adapter per family."
    },
    "compat": {
      "type": "object",
      "required": ["maxDex", "maxMove", "nick"],
      "additionalProperties": false,
      "properties": {
        "maxDex": {"type": "integer", "minimum": 1, "maximum": 2000, "description": "The highest national dex number the game holds."},
        "maxMove": {"type": "integer", "minimum": 1, "maximum": 2000, "description": "The highest move number the game holds."},
        "nick": {"type": "integer", "minimum": 1, "maximum": 16, "description": "The longest nickname the game stores."},
        "visitor": {"type": "boolean", "description": "hello.ok only (FOREIGN_POKEMON_PLAN §4.15): whether the adapter registered its stand-in species, so members this game lacks are visitors; false means they are left out."}
      },
      "description": "A game's compatibility profile: what its shadow party can hold (MULTI_GAME_PLAN §4.9)."
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+$",
      "maxLength": 64,
      "minLength": 1,
      "description": "An engine symbol id, e.g. EVENT_GOT_STARTER. Symbols are engine source names, safe to log."
    },
    "mapId": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$",
      "maxLength": 64,
      "minLength": 1,
      "description": "A map symbol, e.g. PALLET_TOWN."
    },
    "flagId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+$",
      "maxLength": 64,
      "minLength": 1,
      "description": "An event flag symbol (a key of save.flags)."
    },
    "itemId": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$",
      "maxLength": 64,
      "minLength": 1,
      "description": "An item symbol, e.g. POKE_BALL."
    },
    "spriteId": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$",
      "maxLength": 64,
      "minLength": 1,
      "description": "A sprite symbol, e.g. SPRITE_OAK."
    },
    "npcId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+$",
      "maxLength": 96,
      "minLength": 1,
      "description": "A live NPC id, \"<MAP>_obj_<index>\"."
    },
    "objName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+$",
      "maxLength": 96,
      "minLength": 1,
      "description": "A map object name (a key of save.objectToggles[map])."
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "maxLength": 64,
      "minLength": 1,
      "description": "An opaque correlation id chosen by the sender."
    },
    "uid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36,
      "description": "A Pokémon's Cobblemon UUID, lowercase; links the Cobblemon and shadow copies."
    },
    "uiId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "A UI id chosen by gen1-bridge, unique per connection."
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{8,64}$",
      "maxLength": 64,
      "description": "Lowercase hex SHA-256 (or a prefix of one)."
    },
    "dir": {"enum": ["up", "down", "left", "right"]},
    "button": {"enum": ["a", "b", "start", "select", "up", "down", "left", "right"]},
    "coord": {
      "type": "integer",
      "minimum": -4096,
      "maximum": 4096,
      "description": "A cell coordinate (16 px) inside a map; -1 is allowed at map edges."
    },
    "frames": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600,
      "description": "A duration in 60 Hz game frames."
    },
    "count": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "dex": {
      "type": "integer",
      "minimum": 1,
      "maximum": 151,
      "description": "Gen 1 national dex number."
    },
    "nationalDex": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000,
      "description": "Any national dex number (Cobblemon side)."
    },
    "partyDex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000,
      "description": "A party member's national dex number, or 0 for a Cobblemon species that has none (FOREIGN_POKEMON_PLAN §4.1, Q21: a visitor in every game)."
    },
    "level": {"type": "integer", "minimum": 1, "maximum": 100},
    "gen1Move": {
      "type": "integer",
      "minimum": 1,
      "maximum": 165,
      "description": "Gen 1 move id, which equals the Showdown move number."
    },
    "moveNum": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000,
      "description": "Showdown move number."
    },
    "gen1Status": {"enum": ["slp", "psn", "brn", "frz", "par"]},
    "dvs": {
      "type": "object",
      "required": ["atk", "def", "spd", "spc"],
      "additionalProperties": false,
      "properties": {
        "atk": {"type": "integer", "minimum": 0, "maximum": 15},
        "def": {"type": "integer", "minimum": 0, "maximum": 15},
        "spd": {"type": "integer", "minimum": 0, "maximum": 15},
        "spc": {"type": "integer", "minimum": 0, "maximum": 15}
      },
      "description": "Gen 1 DVs. The HP DV is derived from these."
    },
    "ivs": {
      "type": "object",
      "required": ["hp", "atk", "def", "spa", "spd", "spe"],
      "additionalProperties": false,
      "properties": {
        "hp": {"type": "integer", "minimum": 0, "maximum": 31},
        "atk": {"type": "integer", "minimum": 0, "maximum": 31},
        "def": {"type": "integer", "minimum": 0, "maximum": 31},
        "spa": {"type": "integer", "minimum": 0, "maximum": 31},
        "spd": {"type": "integer", "minimum": 0, "maximum": 31},
        "spe": {"type": "integer", "minimum": 0, "maximum": 31}
      },
      "description": "Gen 3 (and later) IVs, one per stat (MG7 G3F)."
    },
    "heldItem": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "description": "MG9 (G2F): the item a Pokémon holds, as the catalogue's canonical id (protocol/items.json), so every game and Cobblemon read it alike; each adapter maps it to its own symbol."
    },
    "gender": {
      "enum": ["male", "female", "genderless"],
      "description": "MG9 (G2F): a Pokémon's gender, in a game that has genders (Gen 2 and later)."
    },
    "form": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,24}$",
      "description": "MG9 (G2F): a Pokémon's form where its species has several: Unown's letter (a..z)."
    },
    "friendship": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "MG9 (G2F): friendship (Gen 2's happiness), 0-255."
    },
    "stats": {
      "type": "object",
      "required": ["hp", "atk", "def", "spa", "spd", "spe"],
      "additionalProperties": false,
      "properties": {
        "hp": {"type": "integer", "minimum": 1, "maximum": 9999},
        "atk": {"type": "integer", "minimum": 1, "maximum": 9999},
        "def": {"type": "integer", "minimum": 1, "maximum": 9999},
        "spa": {"type": "integer", "minimum": 1, "maximum": 9999},
        "spd": {"type": "integer", "minimum": 1, "maximum": 9999},
        "spe": {"type": "integer", "minimum": 1, "maximum": 9999}
      },
      "description": "A Pokémon's six stats as Cobblemon has them (FOREIGN_POKEMON_PLAN §3.2, Q20: every record with a uid shows these numbers); Gen 1's special is spa."
    },
    "typeName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,23}$",
      "description": "A Pokémon type as Showdown and Cobblemon name it, lower case: normal, fire, ..., dark, steel, fairy. Each adapter maps it to its game's (FOREIGN_POKEMON_PLAN §3.2)."
    },
    "nature": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,23}$",
      "description": "A nature as Cobblemon names it, lower case (hardy, adamant, ...): Emerald's summary and Pokéblock taste (FOREIGN_POKEMON_PLAN Q6)."
    },
    "cell": {
      "type": "object",
      "required": ["map", "x", "y"],
      "additionalProperties": false,
      "properties": {
        "map": {"$ref": "#/$defs/mapId"},
        "x": {"$ref": "#/$defs/coord"},
        "y": {"$ref": "#/$defs/coord"}
      }
    },
    "place": {
      "type": "object",
      "required": ["map", "x", "y", "facing"],
      "additionalProperties": false,
      "properties": {
        "map": {"$ref": "#/$defs/mapId"},
        "x": {"$ref": "#/$defs/coord"},
        "y": {"$ref": "#/$defs/coord"},
        "facing": {"$ref": "#/$defs/dir"}
      }
    },
    "cellKey": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+:-?[0-9]+:-?[0-9]+$",
      "maxLength": 80,
      "description": "\"MAP:x:y\", one story cell."
    },
    "npc": {
      "type": "object",
      "required": ["id", "sprite", "kind", "x", "y", "facing", "moving"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/npcId"},
        "sprite": {"$ref": "#/$defs/spriteId"},
        "kind": {"enum": ["person", "item", "boulder", "static", "trainer"]},
        "x": {"$ref": "#/$defs/coord"},
        "y": {"$ref": "#/$defs/coord"},
        "facing": {"$ref": "#/$defs/dir"},
        "moving": {"type": "boolean"}
      }
    },
    "playerState": {
      "type": "object",
      "required": ["mode", "bike", "surf", "slope", "hidden", "dark", "lit"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["idle", "screen", "forced", "cutscene", "busy"]},
        "bike": {"type": "boolean"},
        "surf": {"type": "boolean"},
        "slope": {"type": "boolean"},
        "hidden": {"type": "boolean", "description": "The player sprite is hidden by the game."},
        "dark": {"type": "boolean", "description": "The current map is dark."},
        "lit": {"type": "boolean", "description": "Flash has lit the current dark map."},
        "weather": {"enum": ["none", "clouds", "sunny", "rain", "snow", "thunder", "fog", "ash", "sand", "fog_diagonal", "underwater", "shade", "drought", "downpour", "bubbles"], "description": "SE6 (Gen 3): the weather the hidden game draws now (its field weather; Emerald's abnormal weather shows as drought and downpour in turn, as the game draws it). Absent: the game has no weather."}
      }
    },
    "shadowMon": {
      "type": "object",
      "required": ["dex", "level", "moves"],
      "additionalProperties": false,
      "properties": {
        "uid": {"$ref": "#/$defs/uid"},
        "dex": {"$ref": "#/$defs/partyDex", "description": "FP2: a visitor's real species (0: one with no national number)."},
        "level": {"$ref": "#/$defs/level"},
        "visitor": {"type": "boolean", "description": "FOREIGN_POKEMON_PLAN FP2: the member is a visitor record (the game shows it as its stand-in species)."},
        "nick": {"type": "string", "maxLength": 32, "x-rom-derived": true},
        "moves": {"type": "array", "items": {"$ref": "#/$defs/moveNum"}, "maxItems": 4},
        "hp": {"type": "integer", "minimum": 0, "maximum": 9999},
        "maxhp": {"type": "integer", "minimum": 1, "maximum": 9999},
        "status": {"$ref": "#/$defs/gen1Status"}
      },
      "description": "A party member as one side sees it."
    },
    "teamMon": {
      "type": "object",
      "required": ["dex", "level", "moves"],
      "additionalProperties": false,
      "properties": {
        "dex": {"$ref": "#/$defs/nationalDex"},
        "level": {"$ref": "#/$defs/level"},
        "moves": {
          "type": "array",
          "items": {"$ref": "#/$defs/moveNum"},
          "maxItems": 4,
          "minItems": 1
        },
        "dvs": {"$ref": "#/$defs/dvs"},
        "ivs": {"$ref": "#/$defs/ivs"},
        "item": {"$ref": "#/$defs/heldItem"},
        "shiny": {"type": "boolean"},
        "gender": {"$ref": "#/$defs/gender"},
        "form": {"$ref": "#/$defs/form"}
      },
      "oneOf": [{"required": ["dvs"]}, {"required": ["ivs"]}],
      "description": "A member of a team the hidden game hands over: Gen 1's with DVs, Gen 3's with IVs (MG7 G3F). Its numbers are within the game's compat (maxDex, maxMove), which the adapter keeps and the server checks."
    },
    "empty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "description": "Empty data: {}."
    },
    "warpKind": {
      "enum": [
        "door",
        "stairs",
        "edge",
        "hole",
        "pad",
        "fly",
        "teleport",
        "dig",
        "rope",
        "blackout",
        "script",
        "elevator"
      ]
    },
    "exportKind": {
      "enum": [
        "map",
        "tileset",
        "image",
        "sprite",
        "palettes",
        "encounters",
        "field",
        "names",
        "layout",
        "swaps",
        "profile",
        "routes",
        "g3map",
        "g3tiles",
        "g3image",
        "g3sprite",
        "g3layout",
        "g3encounters",
        "g3names",
        "g3anims",
        "g3sites",
        "g2map",
        "g2tiles",
        "g2image",
        "g2anims",
        "g2sprite",
        "g2layout",
        "g2encounters",
        "g2names"
      ]
    },
    "routeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1,
      "maxLength": 32,
      "description": "A Wild Routes zone id from gen1-bridge/data/routes.json, e.g. viridian_forest_zone."
    },
    "routeObjectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "minLength": 1,
      "maxLength": 32,
      "description": "A zone's trainer or item ball, as the zone's layout names it, e.g. a2.t1."
    },
    "routeProgress": {
      "type": "object",
      "description": "Wild Routes progress by zone id: the item balls taken and how often each trainer was beaten (kept in the hidden save's mod data).",
      "propertyNames": {"$ref": "#/$defs/routeId"},
      "maxProperties": 32,
      "additionalProperties": {
        "type": "object",
        "required": ["taken", "wins"],
        "additionalProperties": false,
        "properties": {
          "taken": {
            "type": "array",
            "items": {"$ref": "#/$defs/routeObjectId"},
            "uniqueItems": true,
            "maxItems": 512
          },
          "wins": {
            "type": "object",
            "propertyNames": {"$ref": "#/$defs/routeObjectId"},
            "maxProperties": 512,
            "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 1000000}
          }
        }
      }
    }
  }
}
