{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kantobridge.invalid/protocol/export/g3map.schema.json",
  "title": "export Gen 3 map",
  "description": "MG7 G3D: one Gen 3 map in cells (16x16 metatiles): its layout's own cells, border, connections, warps and objects, read from the running engine.",
  "x-export-kind": "g3map",
  "type": "object",
  "required": [
    "id",
    "w",
    "h",
    "trueW",
    "trueH",
    "pair",
    "cells",
    "border",
    "connections",
    "warps",
    "objects",
    "mapType",
    "kind",
    "music",
    "weather"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "../defs.schema.json#/$defs/mapId"},
    "w": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1023,
      "description": "The layout's width in cells (the engine places neighbours by it)."
    },
    "h": {"type": "integer", "minimum": 1, "maximum": 1023},
    "trueW": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1023,
      "description": "The map's own width: a small map's layout is padded to w; past trueW and trueH the cells show the border."
    },
    "trueH": {"type": "integer", "minimum": 1, "maximum": 1023},
    "pair": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+$",
      "minLength": 1,
      "maxLength": 64,
      "description": "The engine's id of a primary and secondary tileset pair."
    },
    "cells": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]*={0,2}$",
      "maxLength": 1048576,
      "contentEncoding": "base64",
      "description": "Row-major over w x h, 4 bytes per cell as the engine's layout keeps them: metatile (u16 little-endian, 0-1023), collision (u8, the engine's value), elevation (u8, 0-15). The metatile's behaviour is in g3tiles.",
      "x-rom-derived": true
    },
    "border": {
      "type": "object",
      "required": ["w", "h", "mids"],
      "additionalProperties": false,
      "properties": {
        "w": {"type": "integer", "minimum": 1, "maximum": 16},
        "h": {"type": "integer", "minimum": 1, "maximum": 16},
        "mids": {
          "type": "array",
          "maxItems": 256,
          "items": {"type": "integer", "minimum": 0, "maximum": 1023}
        }
      }
    },
    "connections": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["dir", "map", "offset"],
        "additionalProperties": false,
        "properties": {
          "dir": {"enum": ["north", "south", "east", "west", "dive", "emerge"]},
          "map": {"$ref": "../defs.schema.json#/$defs/mapId"},
          "offset": {
            "type": "integer",
            "minimum": -1024,
            "maximum": 1024,
            "description": "In cells."
          }
        }
      },
      "description": "The map's connections (a direction may have several), offsets in cells."
    },
    "warps": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["x", "y", "warp"],
        "additionalProperties": false,
        "properties": {
          "x": {"type": "integer", "minimum": 0, "maximum": 1023},
          "y": {"type": "integer", "minimum": 0, "maximum": 1023},
          "elev": {"type": "integer", "minimum": 0, "maximum": 15},
          "to": {"$ref": "../defs.schema.json#/$defs/mapId"},
          "warp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "The destination's warp index, as the engine stores it."
          },
          "dynamic": {
            "type": "boolean",
            "description": "The destination is set at run time (no `to`)."
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "maxItems": 255,
      "items": {
        "type": "object",
        "required": ["lid", "gfx", "x", "y", "kind"],
        "additionalProperties": false,
        "properties": {
          "lid": {"type": "integer", "minimum": 1, "maximum": 254},
          "gfx": {"type": "string", "pattern": "^[A-Z0-9_]+$", "minLength": 1, "maxLength": 64},
          "x": {"type": "integer", "minimum": -64, "maximum": 1087},
          "y": {"type": "integer", "minimum": -64, "maximum": 1087},
          "elev": {"type": "integer", "minimum": 0, "maximum": 15},
          "flag": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65534,
            "description": "Its hide flag (hidden while set), when it has one."
          },
          "kind": {"enum": ["person", "item", "trainer", "boulder", "berry", "other"]},
          "stays": {
            "type": "boolean",
            "description": "It keeps its cell (it stands, turns or steps in place); false for one that walks about. Left out when its template has no movement type."
          }
        }
      }
    },
    "mapType": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "The engine's MAP_TYPE_* number."
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z_]+$",
      "maxLength": 32,
      "description": "The engine's kind for it (town, city, route, cave, indoor, ...)."
    },
    "music": {"type": "integer", "minimum": 0, "maximum": 65535},
    "weather": {"type": "integer", "minimum": 0, "maximum": 255},
    "dark": {"type": "boolean", "description": "Item 8: a cave that needs Flash (the map header's cave flag); SE7: also a map whose entry scripts set a flash level above 0 (Dewford Gym), lit while the game's flash level there is 0; absent: lit."}
  }
}
