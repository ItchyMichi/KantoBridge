{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kantobridge.invalid/protocol/export/layout.schema.json",
  "title": "export layout",
  "description": "Block origins of the surface maps, from the engine's own neighbour arithmetic.",
  "x-export-kind": "layout",
  "type": "object",
  "required": ["root", "maps"],
  "additionalProperties": false,
  "properties": {
    "root": {"$ref": "../defs.schema.json#/$defs/mapId"},
    "maps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["x", "y", "w", "h"],
        "additionalProperties": false,
        "properties": {
          "x": {"type": "integer", "minimum": -4096, "maximum": 4096},
          "y": {"type": "integer", "minimum": -4096, "maximum": 4096},
          "w": {"type": "integer", "minimum": 1, "maximum": 255},
          "h": {"type": "integer", "minimum": 1, "maximum": 255}
        }
      },
      "properties": {},
      "propertyNames": {"$ref": "../defs.schema.json#/$defs/mapId"}
    }
  }
}
