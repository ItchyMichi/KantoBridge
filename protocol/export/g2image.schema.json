{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kantobridge.invalid/protocol/export/g2image.schema.json",
  "title": "export Gen 2 image",
  "description": "MG9 G2D: an RGBA image: a page of 1,024 baked 8x8 tiles (32 x 32, ids g2q.<n>).",
  "x-export-kind": "g2image",
  "type": "object",
  "required": [
    "id",
    "w",
    "h",
    "png"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "../defs.schema.json#/$defs/id"
    },
    "w": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "h": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "png": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]*={0,2}$",
      "maxLength": 1048576,
      "contentEncoding": "base64",
      "description": "PNG bytes (RGBA), base64.",
      "x-rom-derived": true
    }
  }
}
