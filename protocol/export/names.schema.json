{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kantobridge.invalid/protocol/export/names.schema.json",
  "title": "export names",
  "description": "Id <-> number maps and display names (display names are game text).",
  "x-export-kind": "names",
  "type": "object",
  "required": ["species", "moves", "items"],
  "additionalProperties": false,
  "properties": {
    "species": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["dex", "name"],
        "additionalProperties": false,
        "properties": {
          "dex": {"$ref": "../defs.schema.json#/$defs/dex"},
          "name": {"type": "string", "maxLength": 200}
        }
      },
      "properties": {},
      "propertyNames": {"$ref": "../defs.schema.json#/$defs/symbol"}
    },
    "moves": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["num", "name"],
        "additionalProperties": false,
        "properties": {
          "num": {"$ref": "../defs.schema.json#/$defs/gen1Move"},
          "name": {"type": "string", "maxLength": 200}
        }
      },
      "properties": {},
      "propertyNames": {"$ref": "../defs.schema.json#/$defs/symbol"}
    },
    "items": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "num": {"type": "integer", "minimum": 0, "maximum": 255},
          "name": {"type": "string", "maxLength": 200},
          "key": {"type": "boolean"}
        }
      },
      "properties": {},
      "propertyNames": {"$ref": "../defs.schema.json#/$defs/symbol"}
    }
  }
}
