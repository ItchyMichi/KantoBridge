{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kantobridge.invalid/protocol/export/sprite.schema.json",
  "title": "export sprite",
  "description": "An overworld sprite sheet: a vertical strip of 16x16 frames.",
  "x-export-kind": "sprite",
  "type": "object",
  "required": ["id", "w", "h", "frames", "walker", "png"],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "../defs.schema.json#/$defs/spriteId"},
    "w": {"const": 16},
    "h": {"type": "integer", "minimum": 16, "maximum": 1024},
    "frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "description": "0 stand down, 1 stand up, 2 stand left, 3 walk down, 4 walk up, 5 walk left; right is left mirrored."
    },
    "walker": {"type": "boolean"},
    "png": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]*={0,2}$",
      "maxLength": 1048576,
      "contentEncoding": "base64",
      "description": "PNG bytes, base64. Greyscale with 4 shades (white, 2/3, 1/3, black)."
    }
  }
}
